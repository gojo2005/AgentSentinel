GROQ_API_KEY=
GROQ_MODEL=
AGENTSENTINEL_LLM_PROVIDER=groq

# LiteLLM providers use LITELLM_MODEL with the matching provider prefix:
# openai/<model-id>, anthropic/<model-id>, or gemini/<model-id>.
LITELLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# LiteLLM Gemini also accepts GOOGLE_API_KEY as an alias.
GOOGLE_API_KEY=

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentsentinel
DATABASE_URL=sqlite:///./data/agentsentinel.db